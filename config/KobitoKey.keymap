#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "jis_keys.h"

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp JP_MHEN>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp JP_HENK>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W      &kp E          &kp R      &kp T          &kp Y      &kp U     &kp I          &kp O      &kp P
&kp A      &kp S      &kp D          &kp F      &kp G          &kp H      &kp J     &kp K          &kp L      &kp JP_MINS
&kp Z      &kp X      &kp C          &kp V      &kp B          &kp N      &kp M     &kp COMMA      &kp DOT    &kp JP_SLSH
&kp LCTRL  &kp LGUI   &lt 1 JP_MHEN  &kp BSPC   &kp SPACE      &kp ENTER  &kp DEL   &lt 2 JP_HENK  &kp RALT   &kp RSHFT
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp ESC      &kp F1     &kp F2    &kp F3    &kp F4       &kp JP_COMM    &kp JP_7      &kp JP_8   &kp JP_9     &kp BSPC
&kp TAB      &kp F5     &kp F6    &kp F7    &kp F8       &kp JP_DOT     &kp JP_4      &kp JP_5   &kp JP_6     &kp JP_SLSH
&kp LSHFT    &kp F9     &kp F10   &kp F11   &kp F12      &kp JP_0       &kp JP_1      &kp JP_2   &kp JP_3     &kp JP_ASTR
&kp LCTRL    &kp LGUI   &trans    &none     &none        &kp JP_PLUS    &kp JP_MINS   &mo 3      &kp JP_EQL   &kp ENTER
            >;
        };

        layer2 {
            label = "SYMBOL";
            bindings = <
&kp JP_EXLM   &kp JP_DQT   &kp JP_HASH   &kp JP_DLR     &kp JP_PERC        &kp JP_AMPR    &kp JP_QUOT   &kp JP_LPRN   &kp JP_RPRN   &kp JP_PIPE
&kp CAPS      &kp UP       &kp INS       &kp HOME       &kp PG_UP          &kp JP_TILD    &kp JP_GRV    &kp JP_LCBR   &kp JP_RCBR   &kp JP_UNDS
&kp LEFT      &kp DOWN     &kp RIGHT     &kp END        &kp PG_DN          &kp JP_CIRC    &kp JP_AT     &kp JP_LBRC   &kp JP_RBRC   &kp JP_YEN
&kp LCTRL     &kp LGUI     &mo 3         &kp JP_COLN    &kp JP_ASTR        &none          &none         &trans        &none         &kp RSHFT
            >;
        };

        layer3 {
            label = "BT";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4        &kp C_VOL_UP    &kp LG(PSCRN)   &none     &none     &none 
&none         &none         &none         &none         &none               &kp C_MUTE      &kp PSCRN       &none     &none     &none 
&none         &none         &none         &none         &none               &kp C_VOL_DN    &kp LA(PSCRN)   &none     &none     &none 
&none         &none         &trans        &none         &none               &none           &none           &trans    &none     &none 
            >;
        };

        layer4 {
            label = "MOUSE";
            bindings = <
&none       &none    &none    &none    &none          &none      &mkp MB1   &mkp MB3   &mkp MB2   &none 
&none       &none    &none    &none    &none          &none      &none      &none      &none      &none 
&kp LSHFT   &none    &none    &none    &none          &none      &none      &none      &none      &none 
&kp LCTRL   &none    &none    &none    &mkp MB4       &mkp MB5   &none      &none      &none      &none 
            >;
        };
    };
};
